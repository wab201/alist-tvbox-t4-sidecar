# NAS 部署时使用的 GHCR 镜像。开发环境执行 docker compose up --build 时可保留默认值。
T4_IMAGE=ghcr.io/wab201/alist-tvbox-t4-sidecar:latest
# 对外暴露的 NAS 端口，容器内部端口固定为 8765。
T4_PORT=8765
# T4 API 必须携带此令牌。请在部署环境替换为随机长字符串。
T4_GATEWAY_TOKEN=replace-with-a-long-random-token
# 使用文件 source 时的容器内路径；只使用订阅 URL 时无需创建该文件。
T4_SOURCES_FILE=/app/config/sources.json
# AT 生成的完整订阅地址。不要把真实地址提交到 Git。
ALIST_TVBOX_SUBSCRIPTION_URL=
T4_WORKER_TIMEOUT=15
T4_SERVICE_NAME=t4-sidecar
T4_VERSION=0.1.0
