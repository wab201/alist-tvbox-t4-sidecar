# NAS 镜像部署。源码构建时改为 alist-tvbox-t4-sidecar:local，避免覆盖发布标签。
T4_IMAGE=ghcr.io/wab201/alist-tvbox-t4-sidecar:latest
# 对外暴露的 NAS 端口，容器内部端口固定为 8765。
T4_PORT=8765
# 使用文件 source 时的容器内路径；只使用订阅 URL 时无需创建该文件。
T4_SOURCES_FILE=/app/config/sources.json
# AT 生成的完整订阅地址。不要把真实地址提交到 Git。
ALIST_TVBOX_SUBSCRIPTION_URL=
# 可在 Web 按订阅保存；以下是 env-at 的初始值，Web 保存值优先。
T4_CLOUD_PLAYBACK_MODE=direct
# 可选，AT 的 Docker 网络/局域网服务地址，不是 PowerList 端口，也不是订阅地址。
ALIST_TVBOX_INTERNAL_URL=
T4_WORKER_TIMEOUT=15
T4_SUBSCRIPTION_CACHE_TTL=30
T4_PLUGIN_DIR=/data/plugins
T4_UPLOAD_MAX_BYTES=2000000
T4_SERVICE_NAME=t4-sidecar
T4_COMPATIBILITY_REPORT=/data/reports/compatibility-latest.json
